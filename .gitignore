# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Fitted model caches written by the scripts (large; regenerated on demand)
models/

# Compiled Stan executables (rebuilt automatically by cmdstanr when the scripts are sourced)
stan/rogan_gladen_bvn_measures_clean
stan/rogan_gladen_bvn_measures_unbounded

.DS_Store
README.html

# Publish simulation ZIP archives, not the unpacked simulation directories.
/simulation_data/sim*/

# Pre-repair copies written by the repair cycles (regenerated on demand)
/simulation_data/bad_runs/

# Compiled Stan executables on Windows
stan/*.exe

# Journal-format TIFF copies of the figures (large; regenerated by the figure scripts)
/figures/submission/

# Data file is downloaded so no need to version control
dep_psp.csv
